filters:
  and:
    - 'file.ext == "md"'
    - 'file.path != this.file.path'
    - or:
        - 'file.folder == this.file.folder'
        - and:
            - 'file.inFolder(this.file.folder)'
            - 'file.folder.split("/").length == this.file.folder.split("/").length + 1'
            - 'file.folder.endsWith(file.basename)'

views:
  - type: list
    name: "目录索引"
    sort:
      - property: 排序
        direction: ASC
    order:
      - file.name
      - 描述
      - 创建时间
