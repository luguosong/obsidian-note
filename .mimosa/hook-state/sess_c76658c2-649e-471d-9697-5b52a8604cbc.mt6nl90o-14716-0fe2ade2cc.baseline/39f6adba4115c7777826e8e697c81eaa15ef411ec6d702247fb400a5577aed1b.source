package com.luguosong.basicsyntax.variable;

/**
 * 变量三要素：数据类型、变量名、变量值。
 * 对应笔记：[[基本语法]] → 变量
 */
public class VariableElements {

    public static void main(String[] args) {
        // 变量三要素：数据类型、变量名、变量值
        int age = 18;
        //  类型   名字   值
        System.out.println("age=" + age);
    }
}
